# Exemplo de variáveis de ambiente para o backend Bicicletário
# Copie para .env e ajuste os valores

PORT=5050
NODE_ENV=development
JWT_SECRET=troque_esta_chave_para_uma_bem_grande
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=coloque_sua_chave_anon_aqui
SUPABASE_SERVICE_ROLE_KEY=coloque_sua_chave_service_role_aqui

# Firebase (para Firestore + Storage)
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
# Coloque o JSON completo da Service Account em uma única linha OU em base64
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"seu-projeto",...}

# Limiar de severidade de alertas (dias de inatividade)
# ALERT_MED_DAYS < ALERT_HI_DAYS (se definir hi < med, o código ajusta hi = med)
ALERT_MED_DAYS=3
ALERT_HI_DAYS=7
# Limiar de atividade de funcionários (minutos)
# Considera Ativo se o último ping for dentro de FUNC_ATIVO_PING_MIN minutos
# ou se a última movimentação ocorrer dentro de FUNC_ATIVO_MOV_MIN minutos
FUNC_ATIVO_PING_MIN=15
FUNC_ATIVO_MOV_MIN=60
