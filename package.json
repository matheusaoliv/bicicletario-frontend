{
  "name": "bicicletario-backend",
  "version": "2.0.0",
  "description": "Backend do Sistema de Bicicletário Municipal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'Build completed'",
    "serve:front": "npx http-server BicicletarioMunicipaldeJaperi -p 3000 -c-1",
    "serve:front:3001": "npx http-server BicicletarioMunicipaldeJaperi -p 3001 -c-1",
    "dev:api": "nodemon server.js",
    "dev:all": "concurrently \"npm:dev\" \"npm:serve:front:3001\"",
    "dev:all:3001": "concurrently \"npm:dev\" \"npm:serve:front:3001\"",
    "dev:all:3000": "concurrently \"npm:dev\" \"npm:serve:front\"",
    "prepare": "node scripts/check-env.js",
    "train:risk": "node scripts/train-risk.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "axios": "^1.13.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.6.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.34.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "bicicletario",
    "municipal",
    "api",
    "supabase"
  ],
  "author": "Prefeitura Municipal",
  "license": "MIT"
}
